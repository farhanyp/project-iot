# Database Connection (PostgreSQL on Docker container port 5433)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/air_minum_db?schema=public"

# Eclipse Mosquitto MQTT Broker
MQTT_BROKER_URL="mqtt://localhost:1883"

# IoT WebSocket Gateway Server
WS_PORT=3001
NEXT_PUBLIC_WS_URL="ws://localhost:3001"

# ==============================================================================
# Payment Gateway: Midtrans (Default Sandbox / Production)
# ==============================================================================
# Dapatkan kredensial di: https://dashboard.midtrans.com/ (Menu Settings -> Access Keys)
# Untuk Sandbox, Server Key berawalan 'SB-Mid-server-...'
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
MIDTRANS_MERCHANT_ID=""
MIDTRANS_IS_PRODUCTION="false"

# Mode Pembayaran QRIS Kiosk & LCD TFT:
# - "core" : Direct QRIS (Menghasilkan qr_string EMVCo untuk LCD TFT ESP32 & image URL langsung tanpa pop-up)
# - "snap" : Pop-up Snap web bawaan Midtrans
PAYMENT_QRIS_MODE="core"

# ==============================================================================
# Alternatif Provider Payment Gateway Lain (Opsional untuk masa depan)
# ==============================================================================
# Tripay (Sangat populer untuk IoT & perorangan di Indonesia):
# TRIPAY_API_KEY=""
# TRIPAY_PRIVATE_KEY=""
# TRIPAY_MERCHANT_CODE=""

# Xendit (Enterprise QR Code API):
# XENDIT_SECRET_KEY=""
