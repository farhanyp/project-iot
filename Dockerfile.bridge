# -------------------------------------------------------------
# Dockerfile for IoT Gateway / Bridge Service (MQTT <-> WebSocket)
# -------------------------------------------------------------
FROM node:22-alpine

WORKDIR /app
RUN apk add --no-cache libc6-compat

COPY package.json package-lock.json* ./
COPY tsconfig.json ./
COPY prisma ./prisma/
COPY prisma.config.ts ./

RUN npm ci
RUN npx prisma generate

COPY lib ./lib/
COPY server ./server/

ENV NODE_ENV=production
ENV WS_PORT=3002

EXPOSE 3002

CMD ["npx", "tsx", "server/iot-bridge.ts"]
